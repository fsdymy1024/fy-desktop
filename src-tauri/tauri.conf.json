{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fy-desktop",
  "version": "0.9.9",
  "identifier": "com.fy.desktop",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "fy-desktop",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "focus": false,
        "visible": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "dragDropEnabled": true,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "fy-desktop.ico"
    },
    "shortDescription": "桌面玻璃小组件与快捷方式收纳",
    "longDescription": "fy-desktop 把天气、时钟、日历、系统监视、网络等小组件放回桌面，并用玻璃收纳格子管理桌面快捷方式。",
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/sign.ps1", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
